<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.Infinite-Locus-Product</groupId>
    <artifactId>qa-automation</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>

    <name>qa-automation</name>
    <description>Shared QA Automation Framework</description>
    <url>https://github.com/Infinite-Locus-Product/qa-automation</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>sachin</id>
            <name>Sachin Bhardwaj</name>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Infinite-Locus-Product/qa-automation</url>
        <connection>scm:git:git://github.com/Infinite-Locus-Product/qa-automation.git</connection>
        <developerConnection>scm:git:ssh://github.com/Infinite-Locus-Product/qa-automation.git</developerConnection>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Sachin Packages</name>
            <url>https://maven.pkg.github.com/Infinite-Locus-Product/qa-automation</url>
        </repository>
    </distributionManagement>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cucumber.version>7.15.0</cucumber.version>
        <selenium.version>4.34.0</selenium.version>
        <gatling.version>3.10.3</gatling.version>
        <gatling-maven-plugin.version>4.7.0</gatling-maven-plugin.version>
        <restassured.version>5.3.2</restassured.version>
        <testng.version>7.9.0</testng.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.squareup.okio/okio -->
        <dependency>
            <groupId>com.squareup.okio</groupId>
            <artifactId>okio</artifactId>
